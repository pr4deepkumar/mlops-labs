# Use an official Python runtime as a parent image (slim: same Python, much smaller image)
FROM python:3.10-slim

# Set the working directory in the container
WORKDIR /app

# Copy requirements.txt on its own first, so the installed packages stay cached
# and are only reinstalled when requirements.txt changes, not on every code change
COPY src/requirements.txt .

# Install Scikit-Learn and joblib (--no-cache-dir keeps pip's download cache out of the image)
RUN pip install --no-cache-dir -r requirements.txt

# Copy the model training script into the container
COPY src/ .

# Run the script when the container launches
CMD ["python", "main.py"]
